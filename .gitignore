# Secrets — never commit API keys
.env
.env.*
!.env.example

# Media and working files (too large for git; they live in Drive / Sync storage)
media/
work/
outputs/
*.mp4
*.mov
*.mp3
*.wav
*.flac

# Python
__pycache__/
*.pyc
.venv/

# Small test exchange files between sessions (inputs, TTS takes, review outputs)
!exchange/
!exchange/**

# Trimmed lip-sync inputs; recreated by tools/sync_stage.py stage2
exchange/*/stage2/src/

# Test deliverables (small, reviewed outputs)
!deliverables/
!deliverables/**

# Full run: large/local-only working files
exchange/full/en/
exchange/full/_ecapa/
exchange/full/review/
exchange/full/analysis/*.jpg
exchange/*/lipsync/src/
exchange/full/en_orig/
exchange/full/qa/

# Melody demo: large/local-only working files
exchange/melody/en/
exchange/melody/lipsync/out/
exchange/melody/lipsync_audio/
exchange/melody_enhe/en/
exchange/melody_enhe/lipsync/out/
exchange/melody_enhe/lipsync_audio/
exchange/melody_enhe/lipsync_zoom/*.mp4
# client footage kept out of git (the push was blocked as sensitive); delivered via chat and a download link
deliverables/melody/Melody_EP101_ES_EN_HE_demo.mp4
