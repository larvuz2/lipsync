# Secrets — never commit API keys
.env
.env.*
!.env.example

# Media and working files (too large for git; they live in Drive / Sync storage)
media/
work/
outputs/
*.mp4
*.mov
*.mp3
*.wav
*.flac

# Python
__pycache__/
*.pyc
.venv/

# Small test exchange files between sessions (inputs, TTS takes, review outputs)
!exchange/
!exchange/**

# Trimmed lip-sync inputs; recreated by tools/sync_stage.py stage2
exchange/*/stage2/src/
