  {"id": "L01", "clip": "00090527", "start": 3.38, "end": 5.86, "character": "FATHER", "en": "Bring me my bracer, then do what your mother says, understand?", "tts": "Bring me my bracer, then do what your mother says, understand?", "was": "Bring me my partridge, ..."},
  {"id": "L02", "clip": "00101676", "start": 0.0, "end": 0.98, "character": "ERZSEBET", "en": "I let you kill it.", "tts": "I let you kill it.", "was": "I was going to kill it."},
  {"id": "L03", "clip": "00102229", "start": 10.2, "end": 12.62, "character": "HUNYADI", "en": "So you're Mihály's sister? Little Erzsébet Szilágyi.", "tts": "So you're Mihai's sister? Little Erzhebet Szilagyi.", "was": "You're Miho's sister, little Erzhebet Szilagyi."},
  {"id": "L04", "clip": "00103629", "start": 1.52, "end": 4.18, "character": "HUNYADI", "en": "But in truth, it belongs to you, my love.", "tts": "But in truth, it belongs to you, my love.", "was": "Though in truth, it was inspired by my love for you."},
  {"id": "L05", "clip": "00103835", "start": 6.62, "end": 7.32, "character": "OLDNOBLE", "en": "Come on!", "tts": "Come on!", "was": "I'm coming."},
  {"id": "L06", "clip": "00104240", "start": 0.64, "end": 1.94, "character": "OLDNOBLE", "en": "Look at the state of you!", "tts": "Look at the state of you!", "was": "How do you look like?"},
  {"id": "L07", "clip": "00104240", "start": 2.38, "end": 5.88, "character": "OLDNOBLE", "en": "Come on, let's go! The King of Hungary is here!", "tts": "Come on, let's go! The King of Hungary is here!", "was": "Come on, get dressed. The king is coming, your Hungarian."},
  {"id": "L08", "clip": "00104240", "start": 6.36, "end": 7.62, "character": "HUNYADI", "en": "Is Sigismund here already?", "tts": "Is Sigismund here already?", "was": "Is Zygismund already here?"},
  {"id": "L09", "clip": "00104461", "start": 0.0, "end": 5.54, "character": "OLDNOBLE", "en": "Only the queen. The king, as usual, is running late.", "tts": "Only the queen. The king, as usual, is running late.", "was": "Only the queen. King Kasnik usually plays with his cow.", "uncertain": true},
  {"id": "L10", "clip": "00104461", "start": 5.82, "end": 6.3, "character": "DARKWOMAN", "en": "Father!", "tts": "Father!", "was": "Wait."},
  {"id": "L11", "clip": "00104461", "start": 6.82, "end": 9.1, "character": "OLDNOBLE", "en": "Thank you, my dear. Jankó!", "tts": "Thank you, my dear. Yahnko!", "was": "Excuse me, Janko."},
  {"id": "L12", "clip": "00104695", "start": 11.7, "end": 12.79, "character": "DARKWOMAN", "en": "It'll be fine.", "tts": "It'll be fine.", "was": "(missing in the dub)"},
  {"id": "L13", "clip": "00105002", "start": 0.0, "end": 2.22, "character": "OLDNOBLE", "en": "You'll behave, won't you?", "tts": "You'll behave, won't you?", "was": "will be want you"},
  {"id": "L14", "clip": "00105386", "start": 5.08, "end": 7.06, "character": "MIKLOS", "en": "Erzsébet Szilágyi is my betrothed.", "tts": "Erzhebet Szilagyi is my betrothed.", "was": "Herjibet Szilagyi is my betrothed."},
  {"id": "L15", "clip": "00108806", "start": 3.24, "end": 5.26, "character": "HUNYADI", "en": "Not nearly as jealous as Újlaki.", "tts": "Not nearly as jealous as Ooylakee.", "was": "Not nearly as jealous as we lucky."}
